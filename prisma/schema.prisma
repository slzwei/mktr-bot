generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlowStatus {
  draft
  published
}

enum ClipStatus {
  ready
  processing
  archived
}

enum CallStatus {
  queued
  dialing
  ringing
  answered
  playing
  listening
  classifying
  ended
  failed
}

model Flow {
  id          String     @id
  name        String
  version     Int        @default(0)
  status      FlowStatus @default(draft)
  startNodeId String
  nodes       Json
  edges       Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?
  versions    FlowVersion[]
  calls       Call[]

  @@index([status, updatedAt])
}

model FlowVersion {
  flowId      String
  version     Int
  graph       Json
  publishedAt DateTime @default(now())
  flow        Flow     @relation(fields: [flowId], references: [id])
  calls       Call[]
  campaigns   Campaign[]

  @@id([flowId, version])
}

model Clip {
  id               String     @id
  name             String
  durationSeconds  Float
  format           String
  status           ClipStatus @default(processing)
  assetUrl         String?
  previewUrl       String?
  telephonyAssetUrl String?
  color            String     @default("teal")
  snapshot         Json
  originalFilename String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status, updatedAt])
}

model Call {
  id             String     @id
  providerCallId String
  destination    String
  callerId       String
  flowId         String
  flowVersion    Int
  campaignId     String?
  contactId      String?
  status         CallStatus
  endReason      String?
  classifier     Json?
  currentNodeId  String?
  snapshot       Json
  createdAt      DateTime   @default(now())
  endedAt        DateTime?
  flow           Flow       @relation(fields: [flowId], references: [id])
  graphVersion   FlowVersion @relation(fields: [flowId, flowVersion], references: [flowId, version])
  events         CallEvent[]
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  contact        Contact? @relation(fields: [contactId], references: [id])
  outcomeDelivery OutcomeDelivery?

  @@index([createdAt])
  @@index([flowId, flowVersion])
  @@index([campaignId, contactId])
}

enum CampaignStatus {
  draft
  running
  paused
  stopped
  completed
}

enum CampaignContactStatus {
  pending
  dialing
  completed
  skipped
}

model Contact {
  id        String @id
  name      String
  phone     String @unique
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaigns CampaignContact[]
  calls     Call[]
}

model Campaign {
  id                String @id
  name              String
  flowId            String
  flowVersion       Int
  callerId          String
  status            CampaignStatus @default(draft)
  callingHours      Json
  maxAttempts       Int
  retryDelaySeconds Int
  dialIntervalMs    Int
  lastDialAt        DateTime?
  outcomeWebhookUrl String?
  outcomeWebhookEnabledAt DateTime?
  snapshot          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  graphVersion      FlowVersion @relation(fields: [flowId, flowVersion], references: [flowId, version])
  contacts          CampaignContact[]
  calls             Call[]
  outcomeDeliveries OutcomeDelivery[]

  @@index([status, createdAt])
}

enum OutcomeDeliveryStatus {
  pending
  delivered
  failed
}

model OutcomeDelivery {
  id            String @id
  callId        String @unique
  campaignId    String
  url           String
  payload       String
  attempts      Int @default(0)
  status        OutcomeDeliveryStatus @default(pending)
  nextAttemptAt DateTime
  createdAt     DateTime @default(now())
  deliveredAt   DateTime?
  lastError     String?
  call          Call @relation(fields: [callId], references: [id])
  campaign      Campaign @relation(fields: [campaignId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([campaignId, createdAt])
}

model CampaignContact {
  id            String @id
  campaignId    String
  contactId     String
  ordinal       Int
  status        CampaignContactStatus @default(pending)
  attempts      Int @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  lastCallId    String?
  outcome       String?
  skipReason    String?
  snapshot      Json
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  contact       Contact @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
  @@unique([campaignId, ordinal])
  @@index([campaignId, status, nextAttemptAt])
}

model CallEvent {
  id        String   @id
  callId    String
  type      String
  title     String
  detail    String?
  nodeId    String?
  latencyMs Int?
  timestamp DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, timestamp])
}


enum UserRole {
  admin
  operator
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ConsentRecord {
  id String @id
  sequence BigInt @unique @default(autoincrement())
  phone String
  snapshot Json
  @@index([phone, sequence])
}
model DncClearance {
  id String @id
  sequence BigInt @unique @default(autoincrement())
  phone String
  snapshot Json
  @@index([phone, sequence])
}

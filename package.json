{
  "name": "mktr-voice-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node .server-dist/server/index.js",
    "test": "tsx --test server/**/*.test.ts",
    "test:media": "tsx --test media-worker/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:restart": "playwright test --config playwright.restart.config.ts",
    "lint": "tsc --noEmit",
    "render:freeswitch": "tsx scripts/render-freeswitch.ts",
    "test:freeswitch": "tsx --test server/freeswitch-config.test.ts",
    "test:inbound": "tsx --test server/inbound-callbacks.test.ts server/freeswitch-config.test.ts",
    "verify:inbound": "tsx scripts/inbound-loopback.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:db": "tsx scripts/test-db.ts",
    "test:db:local": "tsx scripts/test-db-local.ts",
    "verify:runbook": "node scripts/verify-runbook.mjs",
    "test:classifier": "tsx --test server/classifier.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage server/**/*.test.ts",
    "test:backup": "tsx scripts/test-backup.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/multer": "^2.2.0",
    "@xyflow/react": "^12.4.4",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.3.0",
    "openai": "^7.15.0",
    "pino": "^10.3.1",
    "prisma": "6.19.3",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "concurrently": "^9.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": "24.14.0"
  }
}

# The UI and local simulator work with these defaults. Real origination stays disabled
# until all SIP values are supplied and MKTR_TELEPHONY_MODE is set to freeswitch.
PORT=8787
MKTR_TELEPHONY_MODE=simulated
MKTR_MAX_CONCURRENT_CALLS=5
MKTR_ORIGINATE_TIMEOUT_SECONDS=30
MKTR_MAX_CALL_SECONDS=180
MKTR_CLASSIFIER_MODE=rules
MKTR_OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
MKTR_MEDIA_GATEWAY_TOKEN=
MKTR_MEDIA_WORKER_URL=
MKTR_MEDIA_WORKER_PORT=
MKTR_API_INTERNAL_URL=
MKTR_STT_PROVIDER=
MKTR_STT_LANGUAGE=
DEEPGRAM_API_KEY=
MKTR_CLIP_STORAGE_DIR=./storage/clips
MKTR_SINGTEL_SIP_HOST=sipsg01.b3networks.com
MKTR_SINGTEL_SIP_IP=52.77.0.62
MKTR_SINGTEL_PCMA_PORT=5061
MKTR_SINGTEL_OPUS_PORT=5081
MKTR_SINGTEL_SIP_USERNAME=sip69992409
MKTR_SINGTEL_SIP_PASSWORD=
MKTR_FREESWITCH_ESL_HOST=127.0.0.1
MKTR_FREESWITCH_ESL_PORT=8021
MKTR_FREESWITCH_ESL_PASSWORD=
MKTR_FREESWITCH_MEDIA_DIR=/var/lib/freeswitch/recordings/mktr
MKTR_GATEWAY_PUBLIC_IP=
OPENAI_API_KEY=
MKTR_ADMIN_EMAIL=
MKTR_ADMIN_PASSWORD=
MKTR_WEB_ORIGIN=
MKTR_TRUST_PROXY=
CADDY_DOMAIN=
LOG_LEVEL=

# Gateway render inputs; paths point to operator-provided secret files.
MKTR_SINGTEL_CA_CERT_PATH=
MKTR_FREESWITCH_TLS_PEM_PATH=
MKTR_FREESWITCH_BIND_IP=
MKTR_API_TELEPHONY_IP=
MKTR_MEDIA_WORKER_TELEPHONY_IP=
MKTR_FREESWITCH_TEMPLATE_DIR=
MKTR_FREESWITCH_RENDER_DIR=

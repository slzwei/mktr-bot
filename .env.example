# Names only: fill required values in a protected environment outside Git.
# Node does not load this file automatically; use the README's explicit env-file loader.
# Omit unused optional entries from your private file. Simulator is the code default.
PORT=
NODE_ENV=
MKTR_API_PORT=
MKTR_API_PROXY_TARGET=
MKTR_TELEPHONY_MODE=
MKTR_MAX_CONCURRENT_CALLS=
MKTR_ORIGINATE_TIMEOUT_SECONDS=
MKTR_MAX_CALL_SECONDS=
MKTR_CLASSIFIER_MODE=
MKTR_OPENAI_CLASSIFIER_MODEL=
MKTR_CLASSIFIER_TIMEOUT_MS=
MKTR_MEDIA_GATEWAY_TOKEN=
MKTR_MEDIA_WORKER_URL=
MKTR_MEDIA_WORKER_PORT=
MKTR_API_INTERNAL_URL=
MKTR_STT_PROVIDER=
MKTR_STT_LANGUAGE=
DEEPGRAM_API_KEY=
MKTR_DEEPGRAM_BASE_URL=
MKTR_CLIP_STORAGE_DIR=
MKTR_SINGTEL_SIP_HOST=
MKTR_SINGTEL_SIP_IP=
MKTR_SINGTEL_PCMA_PORT=
MKTR_SINGTEL_OPUS_PORT=
MKTR_SINGTEL_SIP_USERNAME=
MKTR_SINGTEL_SIP_PASSWORD=
MKTR_FREESWITCH_ESL_HOST=
MKTR_FREESWITCH_ESL_PORT=
MKTR_FREESWITCH_ESL_PASSWORD=
MKTR_FREESWITCH_MEDIA_DIR=
MKTR_GATEWAY_PUBLIC_IP=
OPENAI_API_KEY=
MKTR_ADMIN_EMAIL=
MKTR_ADMIN_PASSWORD=
MKTR_WEB_ORIGIN=
MKTR_TRUST_PROXY=
CADDY_DOMAIN=
LOG_LEVEL=

# Gateway render inputs; paths point to operator-provided secret files.
MKTR_SINGTEL_CA_CERT_PATH=
MKTR_FREESWITCH_TLS_PEM_PATH=
MKTR_FREESWITCH_BIND_IP=
MKTR_API_TELEPHONY_IP=
MKTR_MEDIA_WORKER_TELEPHONY_IP=
MKTR_FREESWITCH_TEMPLATE_DIR=
MKTR_FREESWITCH_RENDER_DIR=
# Inbound callbacks remain disabled until carrier routing and an uploaded greeting are confirmed.
MKTR_INBOUND_CALLBACK_ENABLED=
MKTR_INBOUND_CLIP_FILE=
MKTR_INBOUND_RECORD_MESSAGE=
MKTR_INBOUND_MAX_MESSAGE_SECONDS=
MKTR_SINGTEL_INBOUND_IP=
# Prisma is the default runtime store; explicit memory is simulator development only.
DATABASE_URL=
DATABASE_TEST_URL=
MKTR_STORE=

# Nonsecret operator runbook paths; kept outside the application container.
MKTR_DEV_ENV=
MKTR_DEPLOY_ENV=
MKTR_FSCLI_PROFILE=
MKTR_VOICE_ORIGIN=
MKTR_RUNBOOK_BACKUP_DIR=
MKTR_TEST_PROVIDER_UUID=
MKTR_FREESWITCH_DIAGNOSTIC_IMAGE=
MKTR_POSTGRES_PASSWORD=
MKTR_BACKUP_DATABASE_URL=
MKTR_BACKUP_CLIP_DIR=
MKTR_RESTORE_DATABASE_URL=
MKTR_RESTORE_CLIP_DIR=
MKTR_OUTCOME_WEBHOOK_ALLOWED_HOSTS=
MKTR_OUTCOME_WEBHOOK_SECRET=

# Optional Singapore Registry checks through the platform gateway (default off).
MKTR_DNC_GATEWAY_URL=
MKTR_DNC_GATEWAY_SECRET=
MKTR_DNC_ENABLED=

# Optional session recording and retention (default off; retention default 30 days).
MKTR_RECORDING_ENABLED=
MKTR_RECORDING_RETENTION_DAYS=
MKTR_RECORDING_STORAGE_DIR=

# Optional media-worker PCM capture for scripts/replay-stt.ts (default off; directory default storage/pcm-capture).
MKTR_PCM_CAPTURE_ENABLED=
MKTR_PCM_CAPTURE_DIR=

# Optional local browser verification ports; credentials/session files are generated by the suite.
MKTR_E2E_API_PORT=
MKTR_E2E_WEB_PORT=

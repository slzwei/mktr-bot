<!--
  Rendered from the Singtel CPaaS values supplied to MKTR.
  Replace the two __...__ placeholders before starting FreeSWITCH.
  Keep the CA certificate in the mounted tls directory.
-->
<include>
  <gateway name="singtel">
    <param name="username" value="__SINGTEL_SIP_USERNAME__"/>
    <param name="auth-username" value="__SINGTEL_SIP_USERNAME__"/>
    <param name="password" value="__SINGTEL_SIP_PASSWORD__"/>
    <param name="realm" value="sipsg01.b3networks.com"/>
    <param name="proxy" value="sipsg01.b3networks.com:5061"/>
    <param name="register-proxy" value="sipsg01.b3networks.com:5061"/>
    <param name="register" value="true"/>
    <param name="register-transport" value="tls"/>
    <param name="caller-id-in-from" value="true"/>
    <param name="sip_cid_type" value="rpd"/>
    <param name="codec-prefs" value="PCMA,PCMU,OPUS"/>
    <param name="absolute_codec_string" value="PCMA"/>
    <param name="rtp-secure-media" value="true"/>
    <param name="dtmf-type" value="rfc2833"/>
    <param name="ping" value="25"/>
  </gateway>
</include>
